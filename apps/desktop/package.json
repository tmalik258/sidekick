    "snd-lib": "1.2.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^24",
    "@types/react": "^19.3.0",

{
  "name": "sidekick",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "dev": "pnpm --filter desktop tauri dev",
    "build": "cargo build --release -p sidekick-voice && pnpm --filter desktop tauri build --config src-tauri/tauri.release.conf.json",
    "web": "pnpm --filter desktop dev",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "pnpm --filter desktop typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15"
  }
}
